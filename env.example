# Connect Robo Backend Environment Variables
# Copy this file to .env and update with your values

# Server Port (default: 5000)
PORT=5000

# MongoDB Connection String
# For local MongoDB: mongodb://localhost:27017/connect-robo
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/connect-robo
DATA_BASE_URL=mongodb://localhost:27017/connect-robo

# Frontend URL for CORS (default: http://localhost:5173)
FRONTED_URL=http://localhost:5173

# JWT Secret Key (generate a random string for production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OTP Secret Key (generate a random string for production)
OTP_SECRET=your-otp-secret-key-change-this-in-production

# Email Configuration (for OTP and password reset)
# Gmail example:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

